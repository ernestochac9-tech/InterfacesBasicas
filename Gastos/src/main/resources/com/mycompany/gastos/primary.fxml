<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="380.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.gastos.PrimaryController">
   <children>
      <Label layoutX="30.0" layoutY="20.0" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Control de Gastos Semanales" />

      <Label layoutX="30.0" layoutY="70.0" text="Alimentación" />
      <TextField fx:id="txtAlimentacion" layoutX="120.0" layoutY="65.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="110.0" text="Refrigerios" />
      <TextField fx:id="txtRefrigerios" layoutX="120.0" layoutY="105.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="150.0" text="Transporte" />
      <TextField fx:id="txtTransporte" layoutX="120.0" layoutY="145.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="190.0" text="Telefonía" />
      <TextField fx:id="txtTelefonia" layoutX="120.0" layoutY="185.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="230.0" text="Otros" />
      <TextField fx:id="txtOtros" layoutX="120.0" layoutY="225.0" prefWidth="100.0" />

      <Label layoutX="300.0" layoutY="70.0" style="-fx-font-weight: bold;" text="Estadísticas" />
      <Label layoutX="300.0" layoutY="105.0" text="Total semanal" />
      <TextField fx:id="txtTotal" editable="false" layoutX="300.0" layoutY="130.0" prefWidth="180.0" />

      <Label layoutX="300.0" layoutY="175.0" text="Gasto más alto" />
      <TextField fx:id="txtMayor" editable="false" layoutX="300.0" layoutY="200.0" prefWidth="180.0" />

      <Button layoutX="30.0" layoutY="290.0" onAction="#btnCalcularEstadisticas_click" prefWidth="140.0" text="Calcular estadísticas" />
      <Button layoutX="185.0" layoutY="290.0" onAction="#btnLimpiar_click" prefWidth="90.0" text="Limpiar" />
   </children>
</AnchorPane>