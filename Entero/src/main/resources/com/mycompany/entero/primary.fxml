<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.entero.PrimaryController">
   <children>
      <Label layoutX="30.0" layoutY="30.0" text="Ingrese un número" />
      <TextField fx:id="txtNumero" layoutX="150.0" layoutY="25.0" prefWidth="120.0" />
      <Button layoutX="300.0" layoutY="25.0" onAction="#btnAnalizar_click" prefWidth="80.0" text="Analizar" />
      <Button layoutX="395.0" layoutY="25.0" onAction="#btnLimpiar_click" prefWidth="80.0" text="Limpiar" />

      <Label layoutX="30.0" layoutY="85.0" text="Cantidad de cifras" />
      <TextField fx:id="txtCantidadCifras" layoutX="180.0" layoutY="80.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="125.0" text="Suma de cifras impares" />
      <TextField fx:id="txtSumaImpares" layoutX="180.0" layoutY="120.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="165.0" text="Suma de cifras pares" />
      <TextField fx:id="txtSumaPares" layoutX="180.0" layoutY="160.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="205.0" text="Suma total de cifras" />
      <TextField fx:id="txtSumaTotal" layoutX="180.0" layoutY="200.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="245.0" text="Cifra mayor" />
      <TextField fx:id="txtCifraMayor" layoutX="180.0" layoutY="240.0" prefWidth="100.0" />

      <Label layoutX="30.0" layoutY="285.0" text="Cifra menor" />
      <TextField fx:id="txtCifraMenor" layoutX="180.0" layoutY="280.0" prefWidth="100.0" />

      <Label layoutX="340.0" layoutY="85.0" text="Divisores" />
      <TextArea fx:id="txtDivisores" layoutX="340.0" layoutY="110.0" prefHeight="240.0" prefWidth="200.0" />
   </children>
</AnchorPane>